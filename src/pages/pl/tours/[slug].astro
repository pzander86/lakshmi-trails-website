---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';

export const prerender = true;

export async function getStaticPaths() {
  let tours = [];
  try {
    tours = (await import('../../../data/tours.pl.json')).default || [];
  } catch (error) {
    console.error('Error loading Polish tours data:', error);
    tours = [];
  }

  return tours.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour, tours }, // Pass all tours for cross-linking
  }));
}

const { tour, tours } = Astro.props;

const structuredData = tour.schema;

// Prepare meta data for your Layout component
const meta = {
  title: `${tour.name} | Lakshmi Trails`,
  description: tour.shortDescription,
  image: `https://lakshmitrails.com${tour.image}`,
  url: `https://lakshmitrails.com/pl/tours/${tour.slug}/`
};
---

<Layout {meta}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Strona główna",
        "item": "https://lakshmitrails.com/pl"
      },
      {
        "@type": "ListItem", 
        "position": 2,
        "name": "Podróże",
        "item": "https://lakshmitrails.com/pl/#tours"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": tour.title,
        "item": `https://lakshmitrails.com/pl/tours/${tour.slug}/`
      }
    ]
  })}></script>

  <!-- SECTION 1: Hero Section -->
  <section id="hero" class="tour-hero">
    <a href="#main-content" class="skip-link">Przejdź do treści</a>
    
    <Image
      src={tour.image}
      alt={`${tour.title} - ${tour.shortDescription}`}
      width={1600}
      height={900}
      loading="eager"
      format="webp"
      class="hero-image"
    />
    <div class="hero-overlay"></div>
    
    <!-- Simple Navigation -->
    <nav class="hero-nav" aria-label="Nawigacja główna">
      <a href="/pl" class="nav-home">← Powrót do strony głównej</a>
      <a href="/pl/#tours" class="nav-tours">Wszystkie podróże</a>
    </nav>

    <div class="hero-content">
      <h1 style="color: white !important;">
        <span class="highlight" style="color: #D4AF37 !important;">{tour.title}</span>
        <br><span class="subtitle" style="color: white !important;">{tour.name}</span>
      </h1>
      <p class="tagline" style="color: rgba(249, 249, 249, 0.95) !important;">
        <span class="dates-info" style="color: #D4AF37 !important;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="color: #D4AF37 !important;">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {tour.dates}
        </span>
        <span class="separator" style="color: rgba(249, 249, 249, 0.7) !important;"> • </span>
        <span class="price-info" style="color: white !important;">{tour.price}</span>
      </p>
    </div>
  </section>

  <main id="main-content" style="order: 2;">
    <!-- SECTION 2: Tour Details -->
    <section id="details" class="tour-details-section">
      <div class="tour-details-container">
        <div class="details-content">
          <h2>Szczegóły podróży</h2>
          <p class="tour-description">{tour.description}</p>
          
          <div class="highlights-grid">
            <h3>Najważniejsze atrakcje</h3>
            <ul class="highlights-list">
              {tour.highlights.map((highlight) => (
                <li set:html={highlight}></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Reserve Your Sacred Journey -->
    <section id="reserve" class="reserve-section" role="region" aria-labelledby="reserve-heading">
      <div class="reserve-container">
        <div class="reserve-content">
          <h2 id="reserve-heading">Zarezerwuj swoją świętą podróż</h2>
          <p class="reserve-intro">
            Gotowy na transformacyjną podróż, która pozostanie z Tobą na całe życie? Skontaktuj się z nami, aby omówić szczegóły i zarezerwować swoje miejsce w tej wyjątkowej przygodzie.
          </p>
          <div class="reserve-actions">
            <a href={tour.pdf} target="_blank" class="cta-button cta-button--outline reserve-download-btn" aria-label={`Pobierz szczegółowy plan podróży dla ${tour.title}`} style="margin-right: 1.5rem;">
              <span>Pobierz szczegółowy plan</span>
            </a>
            <a href="/pl/#contact" class="cta-button" aria-label={`Zarezerwuj miejsce na ${tour.title}`}>
              <span>Zarezerwuj miejsce</span>
            </a>
          </div>
          <p class="reserve-note">
            <strong>Ograniczone do 16 podróżników</strong> dla kameralnych, autentycznych spotkań z eksperckim przewodnictwem przez całą kulturową podróż.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: Other Journeys -->
    <section id="other-tours" class="other-tours-section">
      <div class="other-tours-container">
        <h2>Inne podróże, które mogą Cię zainteresować</h2>
        <div class="other-tours-grid">
          {tours.filter(otherTour => otherTour.slug !== tour.slug).map((otherTour) => (
            <article class="other-tour-card">
              <div class="other-tour-image">
                <Image
                  src={otherTour.image}
                  alt={`${otherTour.title} - ${otherTour.shortDescription}`}
                  width={400}
                  height={240}
                  loading="lazy"
                  format="webp"
                />
                <div class="other-tour-price">{otherTour.price}</div>
              </div>
              <div class="other-tour-content">
                <h3>{otherTour.title}</h3>
                <p class="other-tour-name">{otherTour.name}</p>
                <p class="other-tour-description">{otherTour.description}</p>
                <div class="other-tour-actions">
                  <a href={`/pl/tours/${otherTour.slug}/`} class="cta-button cta-button--secondary cta-button--small" aria-label={`Poznaj szczegóły podróży ${otherTour.title}`}>
                    <span>Poznaj</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12,5 19,12 12,19"></polyline>
                    </svg>
                  </a>
                  <a href="/pl/#contact" class="cta-button cta-button--small" aria-label={`Zarezerwuj miejsce na ${otherTour.title}`}>
                    <span>Zarezerwuj</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 6v6l4 2"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer language="pl" />
</Layout>

<style>
  /* Import all the existing styles from the English version */
  .tour-hero {
    position: relative;
    height: 60vh;
    min-height: 500px;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    z-index: 2;
  }

  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: var(--color-gold);
    color: #000;
    padding: 8px;
    text-decoration: none;
    z-index: 100;
    border-radius: 4px;
    font-weight: 600;
  }

  .skip-link:focus {
    top: 6px;
  }

  .hero-nav {
    position: absolute;
    top: 2rem;
    left: 2rem;
    right: 2rem;
    display: flex;
    justify-content: space-between;
    z-index: 10;
  }

  .hero-nav a {
    color: rgba(249, 249, 249, 0.9);
    text-decoration: none;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: 25px;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .hero-nav a:hover,
  .hero-nav a:focus {
    background: rgba(212, 175, 55, 0.9);
    color: #000;
    border-color: var(--color-gold);
  }

  .hero-content {
    position: relative;
    z-index: 5;
    text-align: center;
    max-width: 900px;
    padding: 0 2rem;
  }

  .hero-content h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .highlight {
    color: var(--color-gold);
  }

  .subtitle {
    color: rgba(249, 249, 249, 0.95);
  }

  .tagline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dates-info,
  .price-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .separator {
    font-weight: bold;
  }

  /* Rest of the tour page styles would be imported/copied from the English version */
  /* For brevity, I'm including key structural styles only */
  
  .tour-details-section,
  .reserve-section,
  .other-tours-section {
    padding: 4rem 2rem;
  }

  .tour-details-container,
  .reserve-container,
  .other-tours-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
  }

  .highlights-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }

  .other-tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .other-tour-card {
    background: var(--color-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .other-tour-card:hover {
    transform: translateY(-5px);
  }

  .reserve-actions {
    display: flex;
    gap: 1rem;
    margin: 2rem 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .hero-nav {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .reserve-actions {
      flex-direction: column;
      align-items: center;
    }
    
    .reserve-download-btn {
      margin-right: 0 !important;
    }
  }
</style>