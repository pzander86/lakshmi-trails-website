---
---

<section id="guide" role="region" aria-labelledby="guide-heading">
  <div class="guide-header">
    <h2 id="guide-heading">Meet Your Guide: A Message from Piotr</h2>
    <div class="decorative-accent" aria-hidden="true"></div>
    <p class="guide-intro">
      I'm Piotr, and Lakshmi Trails is the culmination of my life's journey. Most people spend their whole lives searching for something they can't name. After three years across Asia, I found it in India—and now I want to share what most travelers never discover.
    </p>
  </div>

  <div class="guide-container">
    <div class="video-container">
      <video controls loop preload="metadata" aria-label="Introduction video of Piotr, your guide to South India's sacred traditions and transformative wellness journeys" onloadeddata="this.nextElementSibling.style.opacity='0'" id="guideVideo" playsinline webkit-playsinline muted>
        <source src="/assets/videos/lakshmi-trails-guide-mobile-new.mp4" type="video/mp4" />
      </video>
      <div class="video-placeholder">
        <div class="play-message">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <p>Click to play and hear Piotr's introduction</p>
        </div>
      </div>
    </div>

    <div class="credentials">
      <article class="credential-item">
        <h4>Cultural Bridge</h4>
        <p>Polish-born, US-educated, India-transformed. Bridging cultures with deep understanding.</p>
      </article>
      <article class="credential-item">
        <h4>Lineage-Trained</h4>
        <p>500-RYT yoga, Ayurveda, and Thai massage certifications from authentic traditions.</p>
      </article>
      <article class="credential-item">
        <h4>Intimate Groups</h4>
        <p>Personally lead groups of 12-16 travelers for genuine connections and individual attention.</p>
      </article>
    </div>

  </div>
</section>

<style>
  #guide {
    background: var(--color-mist);
    padding: 7rem 2rem;
    scroll-margin-top: 80px;
  }

  .guide-header {
    text-align: center;
    margin-bottom: 5rem;
    opacity: 0;
    transform: translateY(30px);
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .guide-header.intersecting {
    animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s forwards;
  }

  .guide-header h2 {
    font-family: var(--font-headline);
    font-size: clamp(2.4rem, 4.5vw, 3.2rem);
    color: var(--color-dark-gold);
    margin-bottom: 1rem;
    line-height: 1.15;
    font-weight: 500;
    text-shadow: 0 2px 12px rgba(212, 175, 55, 0.15);
    letter-spacing: -0.01em;
  }

  .decorative-accent {
    width: 80px;
    height: 3px;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-dark-gold) 100%);
    margin: 2rem auto 0 auto;
    position: relative;
    border-radius: 2px;
  }

  .decorative-accent::before,
  .decorative-accent::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    background: var(--color-gold);
    border-radius: 50%;
    top: -3.5px;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.3);
  }

  .decorative-accent::before {
    left: -15px;
  }

  .decorative-accent::after {
    right: -15px;
  }

  .guide-container {
    max-width: 1000px;
    width: 100%;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1.5rem;
    align-items: center;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
  }

  .guide-container.intersecting {
    animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s forwards;
  }

  .video-container {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 
      0 20px 60px rgba(51, 51, 51, 0.15),
      0 8px 25px rgba(0, 0, 0, 0.08);
    aspect-ratio: 3/4;
    background: var(--color-stone);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    max-width: 350px;
    width: 100%;
  }

  .video-container:hover {
    transform: translateY(-5px);
    box-shadow: 
      0 30px 80px rgba(51, 51, 51, 0.2),
      0 12px 35px rgba(0, 0, 0, 0.12);
  }

  .video-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .video-container video::-webkit-media-controls-panel {
    display: flex !important;
    opacity: 1 !important;
  }
  
  .video-container video::-webkit-media-controls {
    display: flex !important;
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-stone) 0%, #444 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    opacity: 1;
    transition: opacity 0.5s ease-out;
    font-family: var(--font-body);
  }

  .video-container video[loaded] + .video-placeholder {
    opacity: 0;
    pointer-events: none;
  }

  .play-message {
    text-align: center;
    padding: 2rem;
  }

  .play-message svg {
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .play-message p {
    font-size: 1.1rem;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
  }

  .guide-header .guide-intro {
    font-size: clamp(1.15rem, 2.5vw, 1.3rem);
    line-height: 1.7;
    color: var(--color-stone);
    margin-top: 2.5rem;
    font-weight: 400;
    font-family: var(--font-body);
    max-width: 850px;
    margin-left: auto;
    margin-right: auto;
  }


  .highlight-text {
    color: var(--color-dark-gold);
    font-style: italic;
    font-weight: 500;
  }

  .credentials {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }
  
  .credentials::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 10%;
    bottom: 10%;
    width: 3px;
    background: linear-gradient(to bottom, transparent, var(--color-gold), var(--color-dark-gold), var(--color-gold), transparent);
    opacity: 0.6;
    border-radius: 2px;
  }

  .credential-item {
    padding: 1.8rem 1.6rem;
    background: rgba(249, 249, 249, 0.95);
    border-radius: 18px;
    border: 1px solid rgba(212, 175, 55, 0.12);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-align: center;
    box-shadow: 
      0 12px 40px rgba(51, 51, 51, 0.1),
      0 4px 15px rgba(0, 0, 0, 0.06);
  }

  .credential-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-dark-gold) 100%);
    border-radius: 18px 18px 0 0;
  }

  .credential-item:hover,
  .credential-item:focus-within {
    transform: translateY(-5px);
    box-shadow: 
      0 15px 40px rgba(51, 51, 51, 0.12),
      0 6px 15px rgba(0, 0, 0, 0.08);
    border-color: rgba(212, 175, 55, 0.25);
  }

  .credential-item h4 {
    font-family: var(--font-headline);
    color: var(--color-dark-gold);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    margin-bottom: 1rem;
    font-weight: 500;
    text-align: center;
    min-height: 1.5em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .credential-item p {
    color: var(--color-stone);
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.6;
    font-weight: 400;
    font-family: var(--font-body);
  }

  .guide-quote {
    font-size: clamp(1.2rem, 2.8vw, 1.35rem);
    font-weight: 500;
    color: var(--color-dark-gold);
    font-family: var(--font-headline);
    margin-top: auto;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    font-style: italic;
    line-height: 1.4;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .guide-header,
    .guide-container {
      animation: none;
      opacity: 1;
      transform: none;
    }
    
    .video-container,
    .credential-item {
      transition: none;
    }
    
    .video-container:hover,
    .credential-item:hover,
    .credential-item:focus-within {
      transform: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .credential-item {
      background: rgba(249, 249, 249, 0.98);
      border-color: var(--color-stone);
    }
    
    .guide-header h2,
    .highlight-text {
      text-shadow: none;
    }
  }

  @media (max-width: 968px) {
    #guide {
      padding: 5rem 2rem;
    }

    .guide-header {
      margin-bottom: 3rem;
      text-align: center;
    }

    .decorative-accent {
      width: 60px;
      margin: 1.5rem auto 0 auto;
    }

    .guide-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .video-container {
      max-width: 450px;
      margin: 0 auto;
    }

    .content-area {
      align-items: center;
    }

    .credentials {
      gap: 2rem;
      max-width: 500px;
      margin: 2rem auto;
    }

    .guide-quote {
      text-align: center;
      margin-top: 2rem;
      padding-top: 2rem;
    }
  }

  @media (max-width: 480px) {
    #guide {
      padding: 4rem 1.5rem;
    }

    .credential-item {
      padding: 1.8rem 1.4rem;
    }
  }
</style>

<!-- Video with controls for audio playback -->